# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
DOMAIN_URL=http://localhost:3000

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Obtener en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ─── Google Calendar API ──────────────────────────────────────────────────────
# Ver README.md sección "Google Calendar" para el flujo OAuth2 completo
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_REFRESH_TOKEN=1//xxxx
GOOGLE_CALENDAR_ID=primary

# ─── Web3Forms ────────────────────────────────────────────────────────────────
# Obtener access key gratuita en: https://web3forms.com
WEB3FORMS_ACCESS_KEY=xxxx

# ─── Transferencia bancaria ───────────────────────────────────────────────────
BANK_ACCOUNT_HOLDER=NOCTEA
BANK_IBAN=ES00 0000 0000 0000 0000 0000
