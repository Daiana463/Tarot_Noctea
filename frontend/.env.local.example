# Google Calendar — cuenta de servicio
# Obtené la private key desde Google Cloud Console > IAM > Cuentas de servicio
GOOGLE_CLIENT_EMAIL=noctea-calendar@noctea-calentario.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Calendar ID
# Para un Gmail personal: compartí el calendario con GOOGLE_CLIENT_EMAIL
# desde Google Calendar > Configuración > Compartir con personas específicas
# Para un calendario secundario: usá el ID tipo xxx@group.calendar.google.com
GOOGLE_CALENDAR_ID=c_6397b6db64222ca5899b084c7eadf565e572bb01d05f96b99c5eccb884f33cbe@group.calendar.google.com

# Timezone para crear eventos en Google Calendar
TIMEZONE=Europe/Madrid

# Web3Forms — clave pública (puede estar en frontend, no es un secreto)
WEB3FORMS_ACCESS_KEY=98ef13f4-76ef-4e1c-bf04-591d3930fdb4
